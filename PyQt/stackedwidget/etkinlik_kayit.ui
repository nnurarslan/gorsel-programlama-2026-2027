  <property name="windowTitle">
   <string>QStackedWidget | Etkinlik Kayıt Sihirbazı</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralwidget { background: #F3F6FB; color: #1E293B; font: 10pt &quot;Segoe UI&quot;; }
QLabel#lblBaslik { font-size: 20pt; font-weight: bold; color: #163B66; padding: 12px; }
QLabel#lblAdim { color: #2563EB; font-weight: bold; padding: 8px; }
QStackedWidget { background: white; border: 1px solid #D7E2EF; border-radius: 14px; }
QStackedWidget QWidget { background: white; }
QLineEdit, QComboBox, QDateEdit, QTimeEdit, QPlainTextEdit, QTextBrowser {
    background: #F8FAFC; border: 1px solid #CBD5E1; border-radius: 8px;
    padding: 9px; color: #0F172A; min-height: 20px;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QTimeEdit:focus {
    border: 2px solid #3B82F6;
}
QGroupBox { border: 1px solid #CBD5E1; border-radius: 9px; margin-top: 12px; padding: 12px; font-weight: bold; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; }
QCheckBox, QRadioButton { spacing: 9px; padding: 6px; }
QCheckBox::indicator, QRadioButton::indicator { width: 17px; height: 17px; }
QPushButton { background: #2563EB; color: white; border: 0; border-radius: 9px; padding: 11px 18px; font-weight: bold; }
QPushButton:hover { background: #1D4ED8; }
QPushButton:disabled { background: #CBD5E1; color: #64748B; }
QPushButton#btnGeri { background: #64748B; }
QPushButton#btnGeri:hover { background: #475569; }
QPushButton#btnTamam { background: #059669; }
QPushButton#btnTamam:hover { background: #047857; }
QStatusBar { background: #163B66; color: white; }
</string>
