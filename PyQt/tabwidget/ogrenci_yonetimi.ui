  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralwidget {
    background: #F1F5F9; color: #1E293B;
    font-family: &quot;Segoe UI&quot;; font-size: 10pt;
}
QLabel { color: #334155; background: transparent; }
QLabel#lblBaslik { color: #142B49; font-size: 17pt; font-weight: bold; }
QTabWidget::pane {
    background: white; border: 1px solid #CBD5E1;
    border-radius: 10px; top: -1px;
}
QTabBar::tab {
    background: #E2E8F0; color: #475569;
    padding: 11px 19px; margin-right: 4px;
    border-top-left-radius: 8px; border-top-right-radius: 8px;
}
QTabBar::tab:selected { background: #2563EB; color: white; }
QTabBar::tab:hover:!selected { background: #BFDBFE; }
QLineEdit, QComboBox {
    background: #F8FAFC; border: 1px solid #CBD5E1;
    border-radius: 7px; padding: 8px; color: #0F172A;
}
QLineEdit:focus, QComboBox:focus { border: 2px solid #3B82F6; }
QPushButton {
    background: #2563EB; color: white; border: none;
    border-radius: 8px; padding: 10px 14px;
    font-weight: 600;
}
QPushButton:hover { background: #1D4ED8; }
QPushButton:pressed { background: #1E40AF; }
QPushButton#btnKaydet { background: #059669; }
QPushButton#btnKaydet:hover { background: #047857; }
QPushButton#btnTemizle { background: #F59E0B; }
QPushButton#btnTemizle:hover { background: #D97706; }
QPushButton#btnYeniSekme { background: #7C3AED; }
QPushButton#btnYeniSekme:hover { background: #6D28D9; }
QPushButton#btnSekmeKapat { background: #EF4444; }
QPushButton#btnSekmeKapat:hover { background: #DC2626; }
QTableWidget {
    background: white; alternate-background-color: #F8FAFC;
    border: 1px solid #CBD5E1; gridline-color: #E2E8F0;
    selection-background-color: #DBEAFE; selection-color: #1E40AF;
}
QHeaderView::section {
    background: #142B49; color: white; border: none; padding: 8px;
}
</string>
