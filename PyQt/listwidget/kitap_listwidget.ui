  <property name="styleSheet">
   <string notr="true">
/* ANA PENCERE */
QMainWindow,
QWidget#centralwidget {
    background-color: #101827;
    font-family: &quot;Segoe UI&quot;;
}

/* BAŞLIK */
QLabel#lblBaslik {
    color: #F5C76A;
    font-size: 25px;
    font-weight: bold;
    padding: 12px;
}

/* KİTAP GİRİŞİ */
QLineEdit#txtKitap {
    background-color: #1E293B;
    color: #FFFFFF;
    border: 2px solid #41516A;
    border-radius: 10px;
    padding: 10px;
    font-size: 14px;
}

QLineEdit#txtKitap:focus {
    border: 2px solid #F5C76A;
}

/* BUTONLAR */
QPushButton {
    color: white;
    border: none;
    border-radius: 10px;
    padding: 11px;
    font-size: 15px;
    font-weight: bold;
    min-height: 24px;
}

/* EKLE - ALTIN */
QPushButton#btnEkle {
    background-color: #E9B95B;
    color: #172033;
}

QPushButton#btnEkle:hover {
    background-color: #F5D48B;
}

QPushButton#btnEkle:pressed {
    background-color: #C99A3D;
}

/* SİL - MİNT YEŞİLİ */
QPushButton#btnSil {
    background-color: #0F766E;
}

QPushButton#btnSil:hover {
    background-color: #0D9488;
}

/* TEMİZLE - BORDO */
QPushButton#btnTemizle {
    background-color: #9F3650;
}

QPushButton#btnTemizle:hover {
    background-color: #BE4965;
}

/* KİTAP LİSTESİ */
QListWidget#listKitaplar {
    background-color: #1E293B;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 8px;
    font-size: 14px;
    outline: none;
}

QListWidget#listKitaplar::item {
    padding: 12px;
    border-bottom: 1px solid #334155;
}

QListWidget#listKitaplar::item:hover {
    background-color: #334155;
}

QListWidget#listKitaplar::item:selected {
    background-color: #E9B95B;
    color: #172033;
    border-radius: 7px;
}

/* ALT BİLGİ */
QLabel#lblDurum {
    color: #F5C76A;
    font-size: 14px;
    font-weight: bold;
    padding: 10px;
}
</string>
